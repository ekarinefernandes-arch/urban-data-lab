# Ambiente virtual
.venv/

# Cache do Python
__pycache__/
*.py[cod]
.pytest_tmp/
.test_artifacts/

# Configurações locais do VS Code
.vscode/

# Arquivos do sistema
.DS_Store
Thumbs.db

# Dados brutos e resultados gerados
data/raw/*
data/processed/*
data/exports/*

# Mantém no repositório a organização das malhas por abrangência territorial
!data/raw/geografia/
data/raw/geografia/*
!data/raw/geografia/*/
data/raw/geografia/*/*
!data/raw/geografia/*/.gitkeep

# Mantém as pastas no Git mesmo quando vazias
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/exports/.gitkeep

ATLAS.md
